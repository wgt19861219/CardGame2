# Godot 4 编辑器/导入缓存（可重建，不入库）
.godot/

# Python 工具缓存（lint/pytest）
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc

# 视觉验收临时截图
screenshots/
# 根目录散落调试截图（MCP/验收临时产物，不入库；项目资源在 assets/）
/*.png
/*.png.import

# 会话临时产物
*.tmp

# plan/worktree 工具临时产物
.zcode/

# brainstorming 视觉伴侣临时产物
.superpowers/

# OS
Thumbs.db
.DS_Store
.claude/worktrees/

# NVIDIA 驱动 shader 缓存（Godot Windows 运行时意外写到项目根的空目录产物）
NVIDIA Corporation/

# 重构临时截图/工具产物（不入库）
tools/refactor/

# ZCode MCP 配置（含本机 node/项目绝对路径，环境专属不入库；从 .agents/mcp.json.example 复制后改）
.agents/mcp.json
