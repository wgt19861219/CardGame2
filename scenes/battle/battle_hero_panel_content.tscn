[gd_scene load_steps=3 format=3]

[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/herobucket.png" id="1_bucket"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/portraitredmask.png" id="2_redmask"]

; VBoxContainer 根：头像/HP/MP 垂直自动排列，separation 控制间距。
; 各 Zone 带 custom_minimum_size 让 VBox 算布局（替代散乱绝对 offset）。
[node name="BattleHeroPanelContent" type="VBoxContainer"]
layout_mode = 3
mouse_filter = 2
theme_override_constants/separation = 7

; 头像区：portrait 104×104 + frame 109×109，Zone 110×115 容纳。
[node name="PortraitZone" type="Control" parent="."]
custom_minimum_size = Vector2(110, 115)
layout_mode = 2
mouse_filter = 2

; PortraitHost 在 Zone 内居中（offset 3,3 让 104 portrait 居中 110 宽）。
[node name="PortraitHost" type="Control" parent="PortraitZone"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 3.0
offset_top = 3.0
mouse_filter = 2

[node name="FrameBtn" type="TextureButton" parent="PortraitZone/PortraitHost"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 2.0
offset_top = 2.0
offset_right = 102.0
offset_bottom = 102.0

; Redmask 定位 frame 贴图中心 (53,53)（源 hero_panel.lua:73 setPosition(anchorPointInPoints)）。
[node name="Redmask" type="Sprite2D" parent="PortraitZone/PortraitHost/FrameBtn"]
unique_name_in_owner = true
visible = false
position = Vector2(53, 53)
texture = ExtResource("2_redmask")

[node name="Container" type="Sprite2D" parent="PortraitZone/PortraitHost"]
position = Vector2(52, 52)
z_index = -2
texture = ExtResource("1_bucket")

; HP 条区：119×17 容纳 HpBar 大条 bg hp_gray（源 hero_panel.lua:15 两条均 HpBar，2026-08-18）。
[node name="HpBarZone" type="Control" parent="."]
custom_minimum_size = Vector2(119, 17)
layout_mode = 2
mouse_filter = 2

[node name="HpBarHost" type="Control" parent="HpBarZone"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 0.0
offset_top = 0.0
mouse_filter = 2

; MP 条区：119×17。
[node name="MpBarZone" type="Control" parent="."]
custom_minimum_size = Vector2(119, 17)
layout_mode = 2
mouse_filter = 2

[node name="MpBarHost" type="Control" parent="MpBarZone"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 0.0
offset_top = 0.0
mouse_filter = 2
