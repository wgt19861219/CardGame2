; 源 crusade.lua:660-680 resetBattle → dialog.lua confirmDialog 家族 showDialog
; （info.sprite 空 CCSprite 存在 → createWithSprite 分支 :339-363，非 createWithText）。
; 点空间直译：Cocos 子坐标系原点=父 contentSize 左下角，子坐标数值即点值——bg 子树不做整体 ÷CS。
; bg contentSize=447x283 像素÷CS=348.88x220.88 点，bg 定位照屏中心 (480,320)；
; bg 内左下原点 (x,y) → Bg 内左上原点 (x, 220.88-y)；贴图显示尺寸=纹理像素÷CS，setContentSize 直译。

[node name="CrusadeResetConfirmContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; 遮罩（源 :37 CCLayerColor ccc4(0,0,0,150) 全屏；模态拦截在 panel 根 STOP）
