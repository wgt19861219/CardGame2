; equipdetail 装备详情两件套静态树（批 1 Task 7，2026-08-15）。框架照源
; equipdetail.lua create(:337-395) 直译（readnode root=layer 场景空间，
; CCLayer 忽略锚点 → 子坐标即 800x480 左下原点场景坐标）；3 段滚动结构照
; createDetail(:135-296) 静态化（标题条+panel_bg 面板+双列网格），行进
; equipdetail_item_cell.tscn（动态数据行模板 instantiate）。
; 坐标换算：cocos(800x480 左下) → godot(960x640 左上) via (x+80, 560-y)，
; 中心锚元素 = 中心点映射后取对称 offsets；贴图显示尺寸 = 纹理像素 ÷ CS(1.28125)。
; 蒙层不进 tscn：PopWindow 基类 shade_layer 同源 mainLayer ccc4(0,0,0,150)。

[node name="EquipdetailContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; 弹窗底板（源 :353-361 bg equip_detail_bg 827x535 at (400,240) 中心锚）：
; 显示 645.3x417.6 = 827x535 ÷ CS，中心 _g(400,240)=(480,320)。
; 修复轮 D（2026-08-18 用户实跑"列表裁剪有问题"）：原 rect 640x400（160..800/120..520）
; 与显示尺寸 645.3x417.6 不符，贴图被非等比压扁（违反等比红线），致弹窗整体偏扁、
; ScrollClip(126..513) 距贴图上下缘仅 6-7px（源内框边距约 15px）——列表视觉压框。
; 等比修正为 157.35..802.65 / 111.2..528.8，裁剪区与贴图内框关系恢复源口径。
[node name="Bg" type="TextureRect" parent="."]
layout_mode = 3
offset_left = 157.35
offset_top = 111.2
offset_right = 802.65
offset_bottom = 528.8
texture = ExtResource("1_bg")
expand_mode = 1
mouse_filter = 2

; 关闭按钮（源 :362-384 close at (700,420) 中心锚 + closePress 挂 close 下
; (700,410) 局部坐标（源 bug 跑飞）→ 双态合并 TextureButton，批内通行做法）：
; 中心 _g(700,420)=(780,140)，显示 65x66（源贴图 1:1）
[node name="CloseBtn" type="TextureButton" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 747.5
offset_top = 107.0
offset_right = 812.5
offset_bottom = 173.0
texture_normal = ExtResource("2_close")
texture_pressed = ExtResource("3_closep")
ignore_texture_size = true

; 装备图标挂点（源 createIcon :298-305 readequip.createIcon(id) at (80,360)
; 中心锚）：中心 _g(80,360)=(160,200)，40x40 容器（工厂 icon fill 挂此）
[node name="IconHost" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 140.0
offset_top = 180.0
offset_right = 180.0
offset_bottom = 220.0
mouse_filter = 2

; 拥有数量（源 :307-317 "x"+amount size18 at (105,300) anchor(0,0.5) + 绿/红
; 直设色 + 黑影(0,1)）：左端 _g(105,300).x=185、中心 y=260；字号/影走
; EquipDetailAmountLabel variation，色 fill font_color override（源直设色）
[node name="AmountLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 185.0
offset_top = 246.0
offset_right = 320.0
offset_bottom = 274.0
theme_type_variation = &"EquipDetailAmountLabel"
mouse_filter = 2
vertical_alignment = 1

; 3 段滚动区（源 createList :321-336 draglist：cliprect CCRectMake(0,47,740,387)
; 场景空间 → 垂直可视界 y 47..434 → godot 126..513；水平源 740 为「不裁水平」
; 宽泛值，取内容面板 560 宽（源 rect(130,47,540,387) 是触摸热区非可视区）。
; canDragY 连续滚动 → ScrollContainer 照 eatexp/equip_strengthen 先例；
; 源自绘左置滚动条（bgpos x=117）→ 引擎默认右侧滚动条，受控偏离。
[node name="ScrollClip" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 200.0
offset_top = 126.0
offset_right = 760.0
offset_bottom = 513.0
mouse_filter = 1
horizontal_scroll_mode = 0

; 滚动内容（源 listLayer 高度=initListHeight(height) 累计）：源 height 初值 15
; → 顶部余量 15；3 段垂直流式（源 gap=20 → VBox separation 20）
[node name="SectionsMargin" type="MarginContainer" parent="ScrollClip"]
layout_mode = 3
mouse_filter = 2
theme_override_constants/margin_top = 15

[node name="SectionsVBox" type="VBoxContainer" parent="ScrollClip/SectionsMargin"]
layout_mode = 3
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 20

