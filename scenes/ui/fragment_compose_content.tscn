; fragment_compose 两件套静态树（批 1 Task 6 核对级，2026-08-15）。
; 框架照源 fragmentcompose.lua create(:252-484)：mainLayer 遮罩由 PopWindow 基类
; shade 承担；源 readnode root = bg sprite（:467 readnode.create(self.bg, ...)），
; 子节点 position 是 bg 局部空间（原点=bg 纹理左下角）——坐标系坑 #1，
; 本树用 PanelLayer 容器承载（exercise PanelLayer / stone_detail 原点偏移同款）：
; bg 369x493 中心 ccp(400,240) → 显示 288x385（÷CS 1.28125），左上 (336,127.5)。
; PanelLayer 下子节点中心 = 源局部 p 的 (p.x, 385-p.y)；贴图显示尺寸=像素÷CS，
; fix_size/scaleSize 显式尺寸直译不÷CS。fill 见 fragment_compose_panel.gd。

[node name="FragmentComposeContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; 面板层 = 源 bg 矩形（局部空间容器，子节点用 bg 局部坐标直放）
[node name="PanelLayer" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 336.0
offset_top = 127.5
offset_right = 624.0
offset_bottom = 512.5
mouse_filter = 2

