; exercise 两件套静态树（批 1 Task 1，2026-08-15）。框架照源 degreeWindow.create 直译
; （CardGameAxmol ui/exercise.lua:694-786）：蒙层/9patch 底框/标题/关闭；7 入口按钮为
; 聚合层发明（源主场景为 FCA 动画入口，无按钮对应物，决策见 exercise_panel.gd 头注）。
; 坐标换算：cocos(800x480 左下) → godot(960x640 左上) via (x+80, 560-y)；
; 贴图显示尺寸 = 纹理像素 / CS(1.28125)。

[node name="ExerciseContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; 蒙层照源 mainLayer CCLayerColor ccc4(0,0,0,150)（exercise.lua:697）。
[node name="Bg" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.588)
mouse_filter = 2

; 关闭按钮照源 close（exercise.lua:723-731）中心 ccp(750,350)；贴图 65x66 ÷CS = 50.7x51.5。
[node name="CloseBtn" type="TextureButton" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 724.6
offset_top = 104.2
offset_right = 775.4
offset_bottom = 155.8
texture_normal = ExtResource("1_close")
texture_pressed = ExtResource("2_closep")
ignore_texture_size = true
stretch_mode = 0

; 面板层照源 frame（exercise.lua:708-720 / cap 出处 :1045）Scale9 main_vit_tips
; capInsets(10,10,58,26)（贴图 103x61，cap 左下原点 → top=61-10-26=25 bottom=y=10）
; scaleSize 705x300 中心 ccp(400,220) → 左上 to_godot(400,220) - (705/2, 300/2) = (127.5,190)。
[node name="PanelLayer" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 47.5
offset_top = 110.0
offset_right = 752.5
offset_bottom = 410.0
mouse_filter = 2

[node name="Frame" type="NinePatchRect" parent="PanelLayer"]
layout_mode = 3
offset_right = 705.0
offset_bottom = 300.0
texture = ExtResource("3_vittips")
patch_margin_left = 8
patch_margin_top = 20
patch_margin_right = 27
patch_margin_bottom = 8
mouse_filter = 2

; 标题照源 title（exercise.lua:763-776）readnode 默认中心锚，场景(399.5,342) → PanelLayer
; 局部中心 (352,28)；字号/颜色走 ExerciseTitleLabel variation（源 ui_normal_button 17 号
; + 阴影(63,5,0) 偏移(0,2) + config 金色(231,206,19)）。
[node name="Title" type="Label" parent="PanelLayer"]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = -1
anchor_left = 0.5
anchor_top = 0.093333
anchor_right = 0.5
anchor_bottom = 0.093333
offset_left = -80.0
offset_top = -12.0
offset_right = 80.0
offset_bottom = 12.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"ExerciseTitleLabel"
mouse_filter = 2
horizontal_alignment = 1
vertical_alignment = 1
text = "试炼"

; 入口网格：行 1 中心 y=165 / 行 2 中心 y=235（行距 70 ≈ 源难度按钮行 y=140 与 vit 行 y=45 的节奏）。
