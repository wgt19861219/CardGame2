; eatexp 吃经验弹窗两件套静态树（批 1 Task 3，2026-08-15）。框架照源 eatexplist.lua
; create(:33-111) 直译；坐标 cocos(800x480 左下) → godot(960x640 左上) via (x+80, 560-y)，
; 中心锚元素 = 中心点映射后取对称 offsets；显示尺寸 = 纹理像素 ÷ CS(1.28125)。
; 源 z 序：frame(0)/title_bg(0) < close(1) < title_bg_1(10) < title(11) → 子节点顺序照排。
; 列表层（draglist）→ ScrollHost + ListHost（源 listLayer）+ Grid 两列；
; 英雄行结构在 eatexp_item.tscn（行模板，源 createHero :204-302）。

[node name="EatexpContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; frame 底板（源 :73-85 package_herolist_bg 700x485 at (400,215) fix_wh={h=345}）：
; readnode setConfig(:215-218) fix_wh 只 setScaleY → 宽不变=700/CS=546.3、高=345，
; 中心 _g(400,215)=(480,345) → rect (206.83,172.5)-(753.17,517.5)
[node name="Bg" type="TextureRect" parent="."]
layout_mode = 3
offset_left = 206.83
offset_top = 172.5
offset_right = 753.17
offset_bottom = 517.5
texture = ExtResource("1_bg")
expand_mode = 1
mouse_filter = 2

