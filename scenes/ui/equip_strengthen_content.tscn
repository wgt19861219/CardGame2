; 进度条裁剪（源 setTextureRect(0,0,655*e/m,18) 裁剪语义）：本引擎 TextureRect 无 region 属性，
; 用 AtlasTexture.region 等价（fill 改 region + offset_right，两条独立实例避免共享）
[sub_resource type="AtlasTexture" id="AtlasBar"]
atlas = ExtResource("9_bar1")
region = Rect2(0, 0, 0, 24)

[sub_resource type="AtlasTexture" id="AtlasAnimBar"]
atlas = ExtResource("10_bar2")
region = Rect2(0, 0, 0, 24)

; equip_strengthen 装备强化两件套静态树（批 1 Task 5，2026-08-15）。框架照源
; equipstrengthen.lua create(:1994-2158) + createnpcTalk(:11-42) + createStrenButton(:789-1028)
; + createExpBar(:1109-1223) + createEquipAtt(:1416-1503) + doShowmbPrompt(:1959-1982)
; + createmtListLayer(:393-412) 直译；坐标 cocos(800x480 左下) → godot(960x640 左上)
; via (x+80, 560-y)，显示尺寸=纹理像素÷CS(1.28125)，readnode 默认中心锚=(0.5,0.5)。
; 单机化裁剪（既有决策）：select_hero 选英雄按钮组 + nohead 未选占位不入树
; （从 HeroDetailPanel 进 hero 已定）。z 序：bg < frame < 头像/槽 < att < bar <
; 材料区 < 按钮区 < close < talk(z50 源) < fx 飘字层。fill 见 equip_strengthen_panel.gd。

[node name="EquipStrengthenContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

