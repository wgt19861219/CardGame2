; 星辰商店商品格行模板（批 2 Task 4，2026-08-16）。照源 uieditor/itemstarshop.lua
; 声明表 8 节点直译：fix_wh=显示尺寸（已含 CS 直接用），layout.position=中心点。
; item_bg 局部空间为 Cocos 左下原点 y-up → Godot 容器内 (x, 286.72-y) 翻转。
; item_press（源 visible=false 按下显示 :204/233/259）由 root TextureButton
; pressed 态承担（texture_pressed 即高亮图）；box icon/灵魂石 icon/文案 fill
; 见 star_shop_panel.gd。noneTag 为 shop.lua:577-588 运行时附挂（visible=amount<1）。

[node name="StarShopItem" type="TextureButton"]
layout_mode = 0
offset_right = 207.03
offset_bottom = 286.72
texture_normal = ExtResource("1_itembg")
texture_pressed = ExtResource("2_itempress")
ignore_texture_size = true
stretch_mode = 0

