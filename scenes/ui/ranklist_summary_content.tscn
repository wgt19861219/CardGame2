; ranklist summary 弹窗静态树（批4 Task 8 坐标修正，2026-08-18）。
; 源 userpvpsummary.lua:18-207：frame Scale9Sprite main_vit_tips.png
; capInsets DGRectMake(20,20,55,25) = CCRectMake(15.625,15.625,42.969,19.531)，贴图 103x61 PIL 实测
; → left=16 / top=26（H-y-h=61-15.625-19.531）/ right=44 / bottom=16（批 1 fde903b 公式）。
; 批4 修正（批2 滚清单"ranklist Frame DG 直译尺寸复核"落地）：
; - frame scaleSize = ed.DGSizeMake(345,305) = (269.53,238.28) 点（readnode setContentSize 直译，
;   DGSizeMake 已含 x0.78125）→ 旧 345x305 为 DG 值未乘系数，修正为 270x238；
; - pos ccp(400,240) 中心锚 → Godot 中心 (480,320) → (345.23,200.86)-(614.77,439.14)；
; - 子元素同口径：DGccp x0.78125 点 + content 层 y-up → Godot y_down = 238.28-y_up。
; 披露维持（NPC 假数据缺）：win_cnt 行/heroes 5 英雄图标/guild 行（源 :113-202）。
; 其余 = px/CS。
[gd_scene load_steps=2 format=3]

[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/main_vit_tips.png" id="1_frame"]

[node name="RanklistSummaryContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Frame" type="NinePatchRect" parent="."]
layout_mode = 3
offset_left = 265.0
offset_top = 121.0
offset_right = 535.0
offset_bottom = 359.0
mouse_filter = 2
texture = ExtResource("1_frame")
patch_margin_left = 12
patch_margin_top = 20
patch_margin_right = 35
patch_margin_bottom = 12

; head DGccp(52,272)=(40.63,212.5) 中心 + fix_size DG(65,65)=(50.78,50.78)
; → (15.24,0.39)-(66.02,51.17) 取整（avatar 动态挂 host）
[node name="AvatarHost" type="Control" parent="Frame"]
unique_name_in_owner = true
layout_mode = 3
offset_left = 15.0
offset_top = 0.0
offset_right = 66.0
offset_bottom = 51.0
mouse_filter = 2

; name 跟 level 图标右侧（DGccp(110,272)=(85.94,212.5) 中心线 y=25.78；等级图标缺披露 → name 从其位起）
