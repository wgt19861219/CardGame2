; dungeon_map 两件套 content 底板（批 3 Task 4，2026-08-16）。
; 照源 ui/dungeon_map.lua:538-676 + gametable/dungeonmapconfig.lua buildUIRes 静态化：
;   dragLayer（CCLayer 全屏 800×480）→ %Scroll 视口 (80,80)-(880,560)；
;   dragContainer → %ScrollContent（内容局部 y=480-cocos_y，宽度 fill 按 boss 延伸）；
;   bg1-3/sub1-3/fog1-3 挂 dragContainer → 同挂 ScrollContent（声明序 = 源 z 序
;   bg0 < boss10/box11 < fog20）；mainLayer 静态层挂 content 根（源 mainLayer 盖 dragLayer）。
; 贴图显示尺寸（crusade 系 TextureConfig 条目全 Prescaled=false → 条目 CS 不施加，
; 只算显式 scale 累乘）：bg=px/CS×2.0（layout scale）、fog=px/CS×4（setScale）、
; 其余无条目=px/CS。
[gd_scene load_steps=15 format=3]

[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/bg.jpg" id="1_bg"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/backbtn.png" id="2_back"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/backbtn-disabled.png" id="3_backp"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_detail_bg1.png" id="4_bg1"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_detail_bg2.png" id="5_bg2"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_detail_bg3.png" id="6_bg3"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_map_frame_light1.png" id="7_l1"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_map_frame_light2.png" id="8_l2"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_map_frame.png" id="9_frame"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_title_bg.png" id="10_title"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_reset_bg.png" id="11_reset"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_fog_1.png" id="12_fog1"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_fog_2.png" id="13_fog2"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade/crusade_fog_3.png" id="14_fog3"]

[node name="DungeonMapContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; 项目适配（PackagePanel 范式）：pushScene→PopWindow 弹窗化全屏底图（源无对应物）
[node name="FrameworkBg" type="TextureRect" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_right = 800.0
offset_bottom = 480.0
texture = ExtResource("1_bg")
expand_mode = 1
mouse_filter = 2

; 源 dragLayer（全屏 800×480 拖拽层 → Godot 横向滚动）
[node name="Scroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 0.0
offset_top = 0.0
offset_right = 800.0
offset_bottom = 480.0
horizontal_scroll_mode = 1
vertical_scroll_mode = 0

; 源 dragContainer（拖动 x∈[min(0,660-maxX),0]；宽度 fill 时 = maxX+140 等价源 calcMaxRight。
; ScrollContainer 按子项 custom_minimum_size 重排（不尊重显式 size），故尺寸走 min 通道）
[node name="ScrollContent" type="Control" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 3
offset_right = 800.0
offset_bottom = 480.0
custom_minimum_size = Vector2(800, 480)
mouse_filter = 2

