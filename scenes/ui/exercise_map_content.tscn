[node name="TitleShadow" type="TextureRect" parent="."]
layout_mode = 3
offset_left = 38.5
offset_top = 31.6
offset_right = 761.4
offset_bottom = 134.4
texture = ExtResource("4_tshadow")
expand_mode = 1
mouse_filter = 2

; 源 frame stage-map-elite-frame 989x549px/CS=771.90x428.39 中心(400,205)→godot(400,275)
[node name="Frame" type="TextureRect" parent="."]
layout_mode = 3
offset_left = 14.05
offset_top = 60.8
offset_right = 785.95
offset_bottom = 489.2
texture = ExtResource("3_frame")
expand_mode = 1
mouse_filter = 2

; 源 titleBg equip_detail_title_bg 388x22px/CS=302.71x17.17 中心(400,355)→godot(400,125)
[node name="TitleBg" type="TextureRect" parent="."]
layout_mode = 3
offset_left = 248.6
offset_top = 116.4
offset_right = 551.4
offset_bottom = 133.6
texture = ExtResource("5_titlebg")
expand_mode = 1
mouse_filter = 2

; 页标题（源 act_title_1/2 失传 → Label；em=时光之穴/equip=英雄试炼，fill 按页切换）
[node name="TitleLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 280.0
offset_top = 111.0
offset_right = 520.0
offset_bottom = 139.0
theme_type_variation = &"TitleLabel"
mouse_filter = 2
horizontal_alignment = 1
vertical_alignment = 1
text = "时光之穴"

; 样式互切（项目适配，2026-09-19 用户拍板「面板内互切按钮」）：切远征地图样式
[node name="SwitchStyleBtn" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 700.0
offset_top = 20.0
offset_right = 795.0
offset_bottom = 56.0
theme_type_variation = &"GhostButton"

[node name="SwitchStylePlate" type="NinePatchRect" parent="SwitchStyleBtn"]
layout_mode = 3
offset_right = 95.0
offset_bottom = 36.0
texture = ExtResource("6_vit")
patch_margin_left = 8
patch_margin_top = 20
patch_margin_right = 27
patch_margin_bottom = 8
mouse_filter = 2

[node name="SwitchStyleLabel" type="Label" parent="SwitchStyleBtn"]
layout_mode = 3
offset_right = 95.0
offset_bottom = 36.0
theme_type_variation = &"WhiteLabel16"
mouse_filter = 2
horizontal_alignment = 1
vertical_alignment = 1
text = "远征样式"

; 关闭（dungeon_map 同款 backbtn 左上）
[node name="CloseBtn" type="TextureButton" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 20.0
offset_top = 15.0
offset_right = 77.76
offset_bottom = 73.54
texture_normal = ExtResource("7_back")
texture_pressed = ExtResource("8_backp")
ignore_texture_size = true
stretch_mode = 0
