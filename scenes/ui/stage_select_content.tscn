; stage_select 两件套 content 底板（批 3 Task 5，2026-08-16）。
; 照源 ui/stageselect.lua 静态段直译：createModeButton:725（buttonBg/normal/elite/guild
; toggle + label）、createChapterButton:705（prev/next 箭头）；frame/title_bg/title label
; 与 map layer/chapter dots 是数据驱动动态层 + crossfade 动画节点（mode/章节切换依赖
; 节点重建，照源 createFrame/createTitle 重建+fade 模式），由 stage_select_fills.gd
; 构造挂 %MapLayerHost/%FrameLayer/%DotContainer——旧死占位 FramePlaceholder/
; TitleBgPlaceholder（运行时被 init 清掉的双头管理债）删除。
; 贴图口径（批3定稿）：显示 = 像素÷CS×条目CS（Prescaled=true 才施加）；本板贴图均
; 无条目 → 像素÷1.28125。坐标：cocos(800×480 左下) → godot = (x+80, 560-y)。
; toggle 129×67px÷CS×0.9（源 refreshModeButtonPosition :245-247 setScale(0.9)；
; normal(345,350)/elite(455,350)/guild(489,350) 为 guild 隐藏布局，源 :240-243）。
[gd_scene load_steps=8 format=3]

[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/bg.jpg" id="1_bg"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/crusade_Button_bg.png" id="2_modebg"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/elitetoggle-ns.png" id="3_toggle"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/prevchap.png" id="4_prev"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/nextchap.png" id="5_next"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/backbtn.png" id="6_back"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/backbtn-disabled.png" id="7_backp"]

[node name="StageSelectContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; 项目适配（源 pushScene 场景 framework.lua:749 自动加全屏 bg.jpg → PopWindow 弹窗化自补）
[node name="FrameworkBg" type="TextureRect" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_right = 800.0
offset_bottom = 480.0
texture = ExtResource("1_bg")
expand_mode = 1
mouse_filter = 2

