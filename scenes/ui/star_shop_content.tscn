; back（package 惯例：57.76x58.54=74x75px/CS at (20,15)，stretch 显式 SCALE）
[node name="CloseBtn" type="TextureButton" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 20.0
offset_top = 15.0
offset_right = 77.76
offset_bottom = 73.54
texture_normal = ExtResource("4_back")
texture_pressed = ExtResource("5_backp")
ignore_texture_size = true
