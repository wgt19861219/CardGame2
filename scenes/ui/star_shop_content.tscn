; 商品横滚区（源 draglist cliprect 直译；starshop noshade=true 无滚动遮罩；E5 横条不显示=3）
[node name="GoodsScroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 65.0
offset_top = 120.0
offset_right = 735.0
offset_bottom = 445.0
horizontal_scroll_mode = 3
vertical_scroll_mode = 0

; 倒计时行（源 HorizontalNode offset 10 间距；starshop 恒 expire 态：title「商人将于」+
; gethmsNString 值 + suffix「后离开」，fill 见 star_shop_panel.gd _update_time_label）
[node name="TimeRow" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = -1
anchor_left = 0.5
anchor_top = 0.270833
anchor_right = 0.5
anchor_bottom = 0.270833
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="TimeTitle" type="Label" parent="TimeRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StarShopTimeTitleLabel"
mouse_filter = 2

[node name="TimeLabel" type="Label" parent="TimeRow"]
unique_name_in_owner = true
layout_mode = 2
