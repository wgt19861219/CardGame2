; 星辰商店主面板静态树（批 2 Task 4，2026-08-16）。照源 market/shop.lua create("starshop")
; + marketconfig.lua ["starshop"].ui_config 场景空间直译（root 直下，弃 PanelLayer 中间层）：
; frame shop_star_frame.png(800x480px) 无 fix_wh → 显示 624.49x374.51（÷CS）中心
; ccp(400,220)；title shop_star_title.png(257x46px) 中心 ccp(403,382) → 显示
; 200.49x35.90；back 走 package 惯例 74x75px/CS（framework CCB 物件无源坐标）。
; draglist cliprect CCRectMake(65,35,670,325)（shop.lua:738）→ (145,200)-(815,525)。
; 倒计时行（批 E E4 补，2026-08-27）：源 shop.lua:801-851 time_title_node HorizontalNode
; 三 Label 横排中心 (400,350) → to_godot=(400,130)；starshop 恒 expire 态（停留 30 天）。
; 横条隐藏（批 E E5）：源 draglist 无横向滚动条（starshop noshade），右缘竖条系
; frame 贴图自带 → horizontal_scroll_mode=3 滚动保留指示不显示。
; 单机化裁剪不入树：showTalk 气泡、head_rect 点击区、StoneLabel（迁移发明常驻余额标签，
; 源无面板级余额显示，不足以价格红字提示）。
; 商品格行模板 star_shop_item.tscn fill 挂 %ItemLayer。

[node name="StarShopContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="FrameworkBg" type="TextureRect" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_right = 800.0
offset_bottom = 480.0
texture = ExtResource("1_bg")
expand_mode = 1
mouse_filter = 2

; frame（显示 624.49x374.51 中心 to_godot(400,220)=(480,340)；旧值 800x480 未÷CS 强拉）
[node name="Frame" type="TextureRect" parent="."]
layout_mode = 0
offset_left = 87.76
offset_top = 72.74
offset_right = 712.24
offset_bottom = 447.26
texture = ExtResource("2_frame")
expand_mode = 1
mouse_filter = 2

; title 图（显示 200.49x35.90 中心 to_godot(403,382)=(483,178)；替代迁移发明文字 Label）
[node name="TitleImg" type="TextureRect" parent="."]
layout_mode = 0
offset_left = 302.76
offset_top = 80.05
offset_right = 503.24
offset_bottom = 115.95
texture = ExtResource("3_title")
expand_mode = 1
