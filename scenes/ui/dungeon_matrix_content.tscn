; dungeon_matrix 两件套 content 底板（2026-09-19，旧版试炼矩阵弹窗）。
; 照源 exercise.lua degreeWindow.createDungeon(:789-880) 骨架：蒙层 + main_vit_tips
; Scale9 705x300 中心场景(400,220)→godot(400,260) + close(750,350)→godot(750,130) +
; 标题 DUNGEON.SELECT_BOSS_DIFFICULTY @(352,355)→godot(352,125)。
; Boss 行（名 + 4 难度格 95x36）走 dungeon_matrix_row.tscn 行模板 fill，
; 行 y 照源 oy=290 dy=-95（cocos）→ godot 190/285/380（fill 定位，见 popup ROW_Y）。
; 受控偏离：源难度按钮 act_select_bg Scale9 95x32（cap 参数语义存疑）→ 统一
; main_vit_tips 名牌样式（与地图入口视觉语言一致，cap L8/T20/R27/B8 同款全尺寸通用）。
[gd_scene load_steps=4 format=3]

[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/main_vit_tips.png" id="1_vit"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/herodetail-detail-close.png" id="2_close"]
[ext_resource type="Texture2D" path="res://assets/ui/alpha/HVGA/herodetail-detail-close-p.png" id="3_closep"]

[node name="DungeonMatrixContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; 蒙层照源 mainLayer CCLayerColor ccc4(0,0,0,150)
[node name="Bg" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.588)
mouse_filter = 2

; 框层（源 frame :803-817 同 create 窗款 705x300 @(400,220)）
[node name="FrameLayer" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 47.5
offset_top = 110.0
offset_right = 752.5
offset_bottom = 410.0
mouse_filter = 2

[node name="Frame" type="NinePatchRect" parent="FrameLayer"]
layout_mode = 3
offset_right = 705.0
offset_bottom = 300.0
texture = ExtResource("1_vit")
patch_margin_left = 8
patch_margin_top = 20
patch_margin_right = 27
patch_margin_bottom = 8
mouse_filter = 2

; 标题（源 :845-862 中心 (352,355)→godot(352,125)→局部 (304.5,15)）
[node name="Title" type="Label" parent="FrameLayer"]
unique_name_in_owner = true
layout_mode = 3
offset_left = 224.5
offset_top = 13.0
offset_right = 384.5
offset_bottom = 41.0
theme_type_variation = &"ExerciseTitleLabel"
mouse_filter = 2
horizontal_alignment = 1
vertical_alignment = 1
text = "选择Boss与难度"

; boss 行宿主（行内 y 相对场景系，fill 按行定位）
[node name="RowHost" type="Control" parent="FrameLayer"]
unique_name_in_owner = true
layout_mode = 3
mouse_filter = 2

[node name="CloseBtn" type="TextureButton" parent="."]
unique_name_in_owner = true
layout_mode = 3
offset_left = 724.6
offset_top = 104.2
offset_right = 775.4
offset_bottom = 155.8
texture_normal = ExtResource("2_close")
texture_pressed = ExtResource("3_closep")
ignore_texture_size = true
stretch_mode = 0
