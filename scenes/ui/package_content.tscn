; 4 列网格（源 :251-276 refreshList cell 中心 dx=75/dy=80、首格中心 (393,343)；cell 视觉 =
; frame 纹理 94×95px ×(74/95) = 73.22×74.0（task-11 修，loadEquip 无 length 原点尺寸 ≈÷CS）→
; 局部起点 = 中心-半视觉尺寸 = (393-36.61+80-435, 560-(343+37)-170)=(1.39, 10.0)——margin 是
; int constant（1.39 截 1，源 436.39 差 0.39px）；间距 sep 2/6（GridContainer int constant，
; 步进 73.22+2=75/74+6=80 照源）走 PackageGrid variation；ScrollContainer 强制子节点贴 (0,0)
; → MarginHost 承载起点偏移；cell 动态 fill（ReadequipIcon 包 wrapper：外层格子 min size，
; 内层保 scale——GridContainer 会重置直接 child 的 scale），列宽 4x73.22+3x2=297 > 视口 295 右缘裁 2px 照源同款）
[node name="MarginHost" type="MarginContainer" parent="ScrollHost"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/margin_left = 1
theme_override_constants/margin_top = 10
mouse_filter = 2

[node name="Grid" type="GridContainer" parent="ScrollHost/MarginHost"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PackageGrid"
columns = 4
mouse_filter = 2
