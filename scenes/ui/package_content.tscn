; z 逃逸修复（审查 F1，2026-08-16）：Cocos zOrder 是 mainLayer 兄弟局部排序；Godot 默认
; z_as_relative=true 沿祖先累加，本 content 挂 PackagePanel（PopWindow z=100 absolute，
; pop_window.gd show_window），Tab*Label z=24 → effective 124 穿透弹窗兜底 100（如
; HandbookPanel 图鉴）。修法=全部直接子节点 z_as_relative=false 绝对化（z 值保持源序：
; 底图/close/handbook 0 < equipbg 2（源 :618）< tab 按钮 1/3（源 :395）< draglist 10
; （源 :355）< label 24（源 :425），均 < 100）。⚠️ z=0 节点（FrameworkBg/CloseBtn/
; HandbookBtn/Tab*Btn）必须一并绝对化——若保持 relative 其 effective=100 会反盖绝对化
; 后的 24/10/3 元素。按钮 z 由 panel _update_tab_visual 运行时设（1/3）。
[node name="FrameworkBg" type="TextureRect" parent="."]
layout_mode = 3
offset_right = 800.0
offset_bottom = 480.0
texture = ExtResource("1_bg")
expand_mode = 1
mouse_filter = 2
z_as_relative = false

[node name="Bg" type="TextureRect" parent="."]
layout_mode = 3
z_index = 2
z_as_relative = false
offset_left = 328.7
offset_top = 75.4
offset_right = 671.3
offset_bottom = 458.6
texture = ExtResource("2_equipbg")
expand_mode = 1
mouse_filter = 2

