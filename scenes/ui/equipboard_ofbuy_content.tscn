; 批5 两件套（2026-08-18 Task 3）：装备购买确认浮层静态 chrome，节点序照源
; ofbuy.lua create 链声明序——initFrame（frame+close）→ initContainer → initTitle（icon/name）
; → initAtt（att_bg+att_list 宿主）→ initAmount（拥有行）→ initWindow（购买行/货币行/确认按钮）。
; 坐标系：源 Cocos 800×480 左下原点 → Godot 960×640 左上；frame 内子坐标 (x,y)→(x, 385-y)；
; 贴图显示尺寸 = 原始像素 ÷ CS 1.28125（均无 TextureConfig 条目）。
; icon/att 行是动态数据 → %IconHost/%AttHost 容器 fill 挂 procedural（面板 gd 负责）。
[node name="EquipboardOfbuyContent" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

